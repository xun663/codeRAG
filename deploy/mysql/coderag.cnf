# CodeRAG 2C4G 生产调优：在 4G 内存里给应用留出空间
# 安装到 /etc/mysql/conf.d/coderag.cnf 后 systemctl restart mysql
[mysqld]
# 缓冲池 512M（数据量小，足够）；日志 flush 放宽换吞吐
innodb_buffer_pool_size = 512M
innodb_log_file_size = 96M
innodb_flush_log_at_trx_commit = 2

# 连接与线程
max_connections = 100
table_open_cache = 512
thread_cache_size = 16
key_buffer_size = 32M

# 临时表/排序，压到 1-2M 防 OOM
sort_buffer_size = 2M
join_buffer_size = 2M
tmp_table_size = 32M
max_heap_table_size = 32M

# 关闭性能库（省内存 + 省 IO）
performance_schema = OFF
