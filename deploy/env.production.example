# CodeRAG 生产环境模板（setup_2c4g.sh 会据此生成 backend/.env）
# 复制改名为 backend/.env 亦可手工使用。密钥均为占位，必须替换。

# ── 应用 ──
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=REPLACE_WITH_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── 数据库（MySQL 8）──
DATABASE_URL=mysql+asyncmy://coderag:REPLACE_DB_PASS@localhost:3306/coderag
DATABASE_URL_SYNC=mysql+pymysql://coderag:REPLACE_DB_PASS@localhost:3306/coderag

# ── Redis / Celery ──
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# ── ChromaDB（嵌入式持久化，进程内）──
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_PERSIST_PATH=./data/chroma_db

# ── LLM：DeepSeek（OpenAI 兼容）──
LLM_API_KEY=REPLACE_WITH_DEEPSEEK_KEY
DEFAULT_LLM_PROVIDER=openai
OPENAI_API_KEY=REPLACE_WITH_DEEPSEEK_KEY
OPENAI_API_BASE=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-v4-flash

# ── 嵌入：云（千问）。注意：base_url 以 DB 的 embedding_config 为准
#    （保存时用 Fernet 加密 api_key），.env 仅作启动兜底。
#    首次部署 setup 脚本已 seed 好 embedding_config，无需在此填 dashscope key。
DEFAULT_EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-v3

# ── 重排：bge-reranker-base（全功能保留，2C4G 内存充足）──
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_CANDIDATE_K=30
RERANK_OUTPUT_K=5
RERANK_BATCH_SIZE=16

# ── 数据清洗 ──
CLEANING_ENABLED=true
CLEANING_NORMALIZE_UNICODE=true
CLEANING_REMOVE_HTML_RESIDUE=true
CLEANING_NORMALIZE_WHITESPACE=true
CLEANING_FILTER_NOISE=true
CLEANING_DEDUPLICATE_PARAGRAPHS=true

# ── 上传 / CORS ──
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=100
CORS_ORIGINS=http://YOUR_SERVER_IP,http://localhost:5173
BACKEND_PORT=8085
