# Database
DATABASE_URL=postgresql+asyncpg://coderag:coderag123@localhost:5432/coderag
DATABASE_URL_SYNC=postgresql://coderag:coderag123@localhost:5432/coderag

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8000

# JWT
SECRET_KEY=change-this-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM Configuration
DEFAULT_LLM_PROVIDER=openai
OPENAI_API_KEY=sk-xxx
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic (optional)
ANTHROPIC_API_KEY=

# Local LLM (optional, via Ollama)
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3

# Embedding
DEFAULT_EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
# For Chinese content: BAAI/bge-small-zh-v1.5
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# App
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
